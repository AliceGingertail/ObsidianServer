# Build stage
FROM golang:1.25-alpine AS builder

WORKDIR /app

# Change Alpine mirror if dl-cdn is blocked
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apk/repositories

# Install build dependencies
RUN apk add --no-cache git

# Copy source code
COPY . .

# Generate go.sum with all dependencies (including indirect)
RUN go mod tidy

# Build application
RUN CGO_ENABLED=0 GOOS=linux go build -o /obsidian-server ./cmd/obsidian-server

# Final stage
FROM alpine:latest

# Change Alpine mirror if dl-cdn is blocked
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apk/repositories

# Install runtime dependencies
RUN apk add --no-cache \
    wireguard-tools \
    iptables \
    ip6tables \
    bash

WORKDIR /app

# Copy binary from builder
COPY --from=builder /obsidian-server /app/obsidian-server

# Copy scripts
COPY deployments/scripts/entrypoint.sh /app/entrypoint.sh
COPY deployments/scripts/setup-wg.sh /app/setup-wg.sh

RUN chmod +x /app/entrypoint.sh /app/setup-wg.sh

# Expose ports
EXPOSE 8080
EXPOSE 51820/udp

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["/app/obsidian-server"]
