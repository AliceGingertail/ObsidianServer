# ObsidianServer Configuration
# Copy to .env and edit as needed.
# All settings have defaults — only set what you want to change.

# ──── Server ────────────────────────────────────────────
# SERVER_PORT=8081

# CORS: comma-separated origins, or "*" for all (NOT recommended for production)
# CORS_ALLOWED_ORIGINS=https://your-domain.com

# Set to "false" after creating your users to close registration
# REGISTRATION_ENABLED=true

# ──── Database ──────────────────────────────────────────
# DB_USER=vpn
# DB_PASSWORD=vpn123          # CHANGE THIS IN PRODUCTION
# DB_NAME=vpn
# DB_SSLMODE=disable

# ──── JWT ───────────────────────────────────────────────
# Auto-generated on first run if empty. Persisted in /etc/wireguard/.jwt_secrets
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# JWT_ACCESS_TTL=15            # minutes
# JWT_REFRESH_TTL=168          # hours (7 days)

# ──── WireGuard ─────────────────────────────────────────
# Auto-detected from public IP if empty. Format: ip:port or domain:port
# WIREGUARD_ENDPOINT=your-server-ip:51821

# WIREGUARD_PORT=51821
# WIREGUARD_SUBNET=10.13.13.0/24
# WIREGUARD_INTERFACE=wg1
# WIREGUARD_DNS=1.1.1.1, 8.8.8.8
# MAX_PEERS_PER_USER=5
